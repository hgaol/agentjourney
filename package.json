{
  "name": "agentjourney-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hgaol/agentjourney.git"
  },
  "bugs": {
    "url": "https://github.com/hgaol/agentjourney/issues"
  },
  "homepage": "https://hgaol.github.io/agentjourney/",
  "scripts": {
    "build": "pnpm generate && pnpm --filter @agentjourney/web build && pnpm --filter @agentjourney/host build && pnpm --filter agentjourney build",
    "check:local-adapters": "tsx scripts/check-local-adapters.ts",
    "dev": "concurrently -k -n host,web -c blue,magenta \"pnpm --filter @agentjourney/host dev\" \"pnpm --filter @agentjourney/web dev\"",
    "e2e": "playwright test",
    "e2e:seed": "tsx scripts/seed-e2e.ts",
    "generate": "pnpm --filter @agentjourney/contracts generate",
    "plugin:create": "tsx scripts/create-plugin.ts",
    "plugin:pack": "tsx scripts/pack-plugin.ts",
    "plugin:check": "tsx scripts/check-plugin.ts",
    "release:check": "node scripts/check-release-ready.mjs",
    "release:pack": "pnpm build && node scripts/pack-release.mjs",
    "release:pack:local": "pnpm build && cross-env AGENTJOURNEY_ALLOW_PRIVATE_PACK=1 node scripts/pack-release.mjs",
    "release:smoke": "node scripts/smoke-package.mjs",
    "release:verify": "pnpm release:pack:local && pnpm release:smoke",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json"
  },
  "devDependencies": {
    "@agentjourney/archive": "workspace:*",
    "@agentjourney/builtin-adapters": "workspace:*",
    "@agentjourney/contracts": "workspace:*",
    "@agentjourney/plugin-runtime": "workspace:*",
    "@agentjourney/plugin-sdk": "workspace:*",
    "@agentjourney/test-fixtures": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.20.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
